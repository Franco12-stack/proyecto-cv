---
// Representación ilustrativa: cada punto es una promoción que el flujo activa o desactiva.
const COLS = 40, ROWS = 12, STEP = 13, R = 10;
const cells = Array.from({ length: COLS * ROWS }, (_, i) => ({ c: i % COLS, r: Math.floor(i / COLS) }));
---
<figure class="pg">
  <svg viewBox={`0 0 ${COLS * STEP} ${ROWS * STEP}`} role="img" aria-label="Matriz ilustrativa de promociones que se activan y desactivan / Illustrative grid of promotions switching on and off">
    {cells.map((c) => <rect x={c.c * STEP} y={c.r * STEP} width={R} height={R} rx="2" style={`animation-delay:${((c.c + c.r * 1.6) * 0.07).toFixed(2)}s`} />)}
  </svg>
  <figcaption><span data-l="es">Representación ilustrativa: cada punto es una promoción.</span><span data-l="en">Illustrative: each dot is a promotion.</span></figcaption>
</figure>
<style>
  .pg{margin:0;width:100%;flex:1;min-height:0;display:flex;flex-direction:column;gap:6px}
  .pg svg{width:100%;flex:1;min-height:0}
  .pg rect{fill:var(--line);animation:pgw 4.5s ease-in-out infinite}
  @keyframes pgw{0%,22%{fill:var(--line)}38%,62%{fill:var(--accent)}78%,100%{fill:var(--line)}}
  .pg figcaption{font:400 11px var(--f-mono);color:var(--dim);letter-spacing:.04em}
  @media (prefers-reduced-motion:reduce){.pg rect{animation:none}.pg rect:nth-child(3n){fill:var(--accent)}}
</style>
