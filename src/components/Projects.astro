---
import es from '../data/site.es.json';
import en from '../data/site.en.json';
import pes from '../data/projects.es.json';
import pen from '../data/projects.en.json';
import T from './T.astro';
import PipelineMini from './PipelineMini.astro';
import BrowserScan from './BrowserScan.astro';
import ObsidianGraph from './ObsidianGraph.astro';
import PriceDash from './PriceDash.astro';
import TicketApp from './TicketApp.astro';
import { url } from '../lib/url';
import flowData from '../data/agente-flow.json';
const flowStats = { nodes: flowData.nodes.length };
const n = pes.length;
const pad = (i: number) => String(i).padStart(2, '0');
---
<section class="pshow" id="proyectos" style={`--n:${n}`} aria-label="Proyectos / Projects">
  <div class="pstick">
    <div class="pside">
      <div>
        <h2><T es={es.sections.projects} en={en.sections.projects} /></h2>
        <p class="psub"><T es={es.ui.projectsSub} en={en.ui.projectsSub} /></p>
      </div>
      <div class="pnav">
        <p class="pcount" aria-hidden="true"><b id="pcur">01</b><span> / {pad(n)}</span></p>
        <div class="pbars">
          {pes.map((p, i) => (
            <button type="button" class={'pbar' + (i === 0 ? ' on' : '')} data-i={i} aria-label={`${es.ui.projectN} ${i + 1} / ${n}: ${p.title}`}></button>
          ))}
        </div>
        <p class="phint"><span aria-hidden="true">↓</span><T es={es.ui.scrollHint} en={en.ui.scrollHint} /></p>
      </div>
    </div>
    <ul class="pcards" aria-label="Lista de proyectos / Project list">
      {pes.map((p, i) => (
        <li class={'pcard' + (i === 0 ? ' on' : '')} data-i={i}>
          <div class={'pvis' + ((p as any).image ? ' has-img' : '') + ((p as any).diagram ? ' has-flow' : '')}>
            {(p as any).image ? (
              <img src={url('/' + (p as any).image)} alt={(p as any).imageAlt} width="1280" height="800" loading="lazy" decoding="async" />
            ) : (<>
              {(p as any).diagram === 'n8n' ? (<>
                <ul class="pstats">
                  <li><b>50+</b><span><T es="interacciones diarias" en="daily interactions" /></span></li>
                  <li><b>50+</b><span><T es="flujos 24/7" en="workflows 24/7" /></span></li>
                  <li><b>{flowStats.nodes}</b><span><T es="nodos en el flujo del agente" en="nodes in the agent workflow" /></span></li>
                </ul>
                <PipelineMini />
              </>) : (p as any).diagram === 'promos' ? (<>
                <ul class="pstats"><li><b>{p.metric.v}</b><span><T es="promociones activadas o desactivadas de forma autónoma" en="promotions activated or deactivated autonomously" /></span></li></ul>
                <BrowserScan />
              </>) : (p as any).diagram === 'tickets' ? (<>
                <TicketApp />
              </>) : (p as any).diagram === 'prices' ? (<>
                <PriceDash />
              </>) : (p as any).diagram === 'brain' ? (<>
                <ul class="pstats"><li><b>{p.metric.v}</b><span><T es={p.metric.l} en={pen[i].metric.l} /></span></li></ul>
                <ObsidianGraph />
              </>) : (<>
              <p class="pval">{p.metric.v}</p>
              <p class="plab"><T es={p.metric.l} en={pen[i].metric.l} /></p>
              </>)}
              {(p as any).diagram ? null : (
              <ol class="pflow" aria-label="Stack">
                {p.tags.map((t, j) => <li><T es={t} en={pen[i].tags[j]} /></li>)}
              </ol>)}
            </>)}
            <span class="pidx" aria-hidden="true">{pad(i + 1)}</span>
            {(p as any).links?.github && <a class="plink" href={(p as any).links.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>}
          </div>
          <h3><T es={p.title} en={pen[i].title} />{p.pill && <span class="pill"><T es={p.pill} en={(pen[i] as any).pill} /></span>}</h3>
          {((p as any).image || (p as any).diagram) && <ul class="tags ptags">{p.tags.map((t, j) => <li><T es={t} en={pen[i].tags[j]} /></li>)}</ul>}
          <p class="psum"><T es={p.summary} en={pen[i].summary} /></p>
          <p class="pfoot"><span><T es={es.ui.viewCase.replace(' →', '')} en={en.ui.viewCase.replace(' →', '')} /></span><span class="arr" aria-hidden="true">↗</span></p>
          <a class="pcover" href={url(`/proyectos/${p.slug}/`)}><span class="sr"><T es={`${es.ui.viewCase} ${p.title}`} en={`${en.ui.viewCase} ${pen[i].title}`} /></span></a>
        </li>
      ))}
    </ul>
  </div>
</section>
