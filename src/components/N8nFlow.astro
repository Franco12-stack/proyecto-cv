---
// Lienzo estilo n8n (ilustrativo): disparador → agente de IA (Claude + herramientas) → APIs REST → respuesta.
const main = [
  { x: 20, t: ['Webhook', 'Webhook'], s: ['Disparador', 'Trigger'], k: 'W' },
  { x: 232, t: ['Agente de IA', 'AI Agent'], s: ['Claude · tool use', 'Claude · tool use'], k: 'AI', big: true },
  { x: 444, t: ['APIs REST', 'REST APIs'], s: ['Sistemas por API', 'Systems via API'], k: 'API' },
  { x: 656, t: ['Responder', 'Respond'], s: ['Respuesta al cliente', 'Reply to customer'], k: '✓' },
];
const subs = [
  { x: 216, t: ['Modelo: Claude API', 'Model: Claude API'] },
  { x: 340, t: ['Herramientas', 'Tools'] },
];
const W = 180, H = 76, Y = 56;
---
<figure class="n8n">
  <svg viewBox="0 0 856 250" role="img" aria-label="Diagrama ilustrativo de un flujo de n8n: webhook, agente de IA con Claude y herramientas, APIs REST y respuesta" xmlns="http://www.w3.org/2000/svg">
    <defs><marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 8 4 0 8z" fill="var(--accent)"/></marker></defs>
    {main.slice(0, -1).map((n, i) => (
      <path class="edge" d={`M${n.x + W} ${Y + H / 2} L${main[i + 1].x} ${Y + H / 2}`} marker-end="url(#arr)" />
    ))}
    {subs.map((s) => (
      <path class="edge sub" d={`M${s.x + 58} 168 C ${s.x + 58} 150, 322 150, 322 ${Y + H}`} />
    ))}
    {main.map((n) => (
      <g class={'nd' + (n.big ? ' big' : '')} transform={`translate(${n.x} ${Y})`}>
        <rect width={W} height={H} rx="8" />
        <rect class="ic" x="0" y="0" width="44" height={H} rx="8" />
        <text class="ik" x="22" y={H / 2 + 5} text-anchor="middle">{n.k}</text>
        <text data-l="es" class="tt" x="56" y="33">{n.t[0]}</text><text data-l="en" class="tt" x="56" y="33">{n.t[1]}</text>
        <text data-l="es" class="ts" x="56" y="54">{n.s[0]}</text><text data-l="en" class="ts" x="56" y="54">{n.s[1]}</text>
      </g>
    ))}
    {subs.map((s) => (
      <g class="nd sm" transform={`translate(${s.x} 168)`}>
        <rect width="116" height="40" rx="20" />
        <text data-l="es" class="ts" x="58" y="25" text-anchor="middle">{s.t[0].replace('Modelo: ', '')}</text><text data-l="en" class="ts" x="58" y="25" text-anchor="middle">{s.t[1].replace('Model: ', '')}</text>
      </g>
    ))}
    <text class="cap" x="20" y="240"><tspan data-l="es">Diagrama ilustrativo de la arquitectura, no es el workflow exportado.</tspan><tspan data-l="en">Illustrative architecture diagram, not the exported workflow.</tspan></text>
  </svg>
</figure>
<style>
  .n8n{margin:0;width:100%}
  .n8n svg{display:block;width:100%;height:auto;max-height:100%}
  .n8n .edge{fill:none;stroke:var(--accent);stroke-width:2;stroke-dasharray:6 5;animation:dash 1.2s linear infinite}
  .n8n .edge.sub{stroke:var(--dim);stroke-width:1.5}
  @keyframes dash{to{stroke-dashoffset:-22}}
  .n8n .nd rect:first-child{fill:var(--surface);stroke:var(--line);stroke-width:1.5}
  .n8n .nd.big rect:first-child{stroke:var(--accent)}
  .n8n .nd .ic{fill:var(--accent-soft);stroke:none}
  .n8n .ik{font:700 14px var(--f-mono);fill:var(--accent)}
  .n8n .tt{font:600 15px var(--f-body);fill:var(--ink)}
  .n8n .ts{font:400 11.5px var(--f-mono);fill:var(--dim)}
  .n8n .sm rect{stroke:var(--dim)!important}
  .n8n .cap{font:400 11px var(--f-mono);fill:var(--dim)}
  @media (prefers-reduced-motion:reduce){.n8n .edge{animation:none}}
</style>
