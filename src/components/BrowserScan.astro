---
// Ilustración animada: un navegador recorre la lista de promociones y las activa o desactiva una por una.
const ROWS = 7, T = 10; // segundos por pasada
const rows = Array.from({ length: ROWS }, (_, i) => ({ i, d: ((i + 0.6) * T) / (ROWS + 0.4) }));
---
<figure class="bs" style={`--T:${T}s`}>
  <div class="bw" role="img" aria-label="Ilustración: un navegador recorre una lista de promociones y las activa o desactiva / Illustration: a browser goes through a list of promotions switching them on and off">
    <div class="bar">
      <i></i><i></i><i></i>
      <span class="url">mercadolibre · <span data-l="es">promociones</span><span data-l="en">promotions</span></span>
      <span class="live"><b></b><span data-l="es">Claude escaneando</span><span data-l="en">Claude scanning</span></span>
    </div>
    <div class="pg">
      {rows.map((r) => (
        <div class={'rw ' + (r.i % 2 ? 'b' : 'a')} style={`--d:${r.d.toFixed(2)}s`}>
          <span class="th"></span>
          <span class="ln"><u></u><u></u></span>
          <span class="pr"></span>
          <span class="sw"><span class="kn"></span></span>
        </div>
      ))}
      <div class="scan" aria-hidden="true">
        <svg class="cur" viewBox="0 0 16 20" width="16" height="20"><path d="M1 1l12 9-5.2 1 3.2 7-2.4 1-3.2-7L1 17z" fill="var(--accent)" stroke="var(--bg)" stroke-width="1"/></svg>
      </div>
    </div>
  </div>
  <figcaption><span data-l="es">Ilustración del flujo: el navegador recorre las promociones y las activa o desactiva.</span><span data-l="en">Illustration of the flow: the browser goes through the promotions and switches them on or off.</span></figcaption>
</figure>
<style>
  .bs{margin:0;width:100%;flex:1;min-height:0;display:flex;flex-direction:column;gap:6px}
  .bw{flex:1;min-height:0;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:8px;background:var(--bg);overflow:hidden}
  .bar{display:flex;align-items:center;gap:6px;padding:7px 10px;border-bottom:1px solid var(--line);background:var(--surface)}
  .bar i{width:9px;height:9px;border-radius:50%;background:var(--line)}
  .bar i:first-child{background:var(--dim)}
  .url{margin-left:8px;flex:1;max-width:260px;font:400 11px var(--f-mono);color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:2px 10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .live{margin-left:auto;display:flex;align-items:center;gap:6px;font:500 10px var(--f-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}
  .live b{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:bsb 1.2s ease-in-out infinite}
  @keyframes bsb{50%{opacity:.25}}
  .pg{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;justify-content:space-evenly;padding:6px 12px}
  .rw{display:grid;grid-template-columns:30px 1fr 54px 38px;align-items:center;gap:12px;padding:4px 8px;border-radius:6px;animation-duration:calc(var(--T)*2);animation-iteration-count:infinite;animation-timing-function:linear;animation-delay:var(--d);animation-fill-mode:backwards;animation-name:bsf}
  .th{height:22px;border-radius:4px;background:var(--line)}
  .ln{display:grid;gap:5px}.ln u{display:block;height:6px;border-radius:3px;background:var(--line)}.ln u:last-child{width:55%;opacity:.6}
  .pr{height:8px;border-radius:3px;background:var(--dim);opacity:.5}
  .sw{position:relative;height:18px;border-radius:9px;background:var(--line);animation:inherit;animation-name:bsta}
  .kn{position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:var(--ink);animation:inherit;animation-name:bska}
  .rw.b .sw{animation-name:bstb}.rw.b .kn{animation-name:bskb}
  @keyframes bsf{0%{background:transparent}2%{background:var(--accent-soft)}12%,48%{background:transparent}50%{background:var(--accent-soft)}62%,100%{background:transparent}}
  @keyframes bsta{0%{background:var(--line)}2%,48%{background:var(--accent)}50%,100%{background:var(--line)}}
  @keyframes bska{0%{left:2px}2%,48%{left:22px}50%,100%{left:2px}}
  @keyframes bstb{0%{background:var(--accent)}2%,48%{background:var(--line)}50%,100%{background:var(--accent)}}
  @keyframes bskb{0%{left:22px}2%,48%{left:2px}50%,100%{left:22px}}
  .scan{position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent) 20%,var(--accent) 80%,transparent);box-shadow:0 0 14px 2px var(--accent);animation:bssc var(--T) linear infinite;pointer-events:none}
  .scan::after{content:"";position:absolute;left:0;right:0;top:-26px;height:26px;background:linear-gradient(transparent,var(--accent-soft))}
  .cur{position:absolute;right:56px;top:-2px;filter:drop-shadow(0 0 4px var(--accent))}
  @keyframes bssc{0%{top:0}100%{top:calc(100% - 2px)}}
  .bs figcaption{font:400 11px var(--f-mono);color:var(--dim);letter-spacing:.04em}
  @media (prefers-reduced-motion:reduce){.rw,.sw,.kn,.scan,.live b{animation:none!important}.rw.a .sw{background:var(--accent)}.rw.a .kn{left:22px}.rw.b .sw{background:var(--line)}.rw.b .kn{left:2px}.scan{display:none}}
</style>
