---
import es from '../data/site.es.json';
import en from '../data/site.en.json';
import T from './T.astro';
import FlowDemo from './FlowDemo.astro';
const ticker = es.ticker.map((w) => `${w}<i>✱</i>`).join('');
---
<div class="hero">
  <p class="tag"><T es={es.hero.tag} en={en.hero.tag} /></p>
  <h1><T es={es.hero.h1} en={en.hero.h1} /></h1>
  <p class="lead"><T es={es.hero.lead} en={en.hero.lead} /></p>
  <div class="meta">
    {es.hero.meta.map((m, i) => (
      <div><small><T es={m.k} en={en.hero.meta[i].k} /></small>
        {m.v === 'clock' ? <span data-clock>--:--:--</span> : <span><T es={m.v} en={en.hero.meta[i].v} /></span>}</div>
    ))}
  </div>
  <FlowDemo />
  <div class="ticker" aria-hidden="true"><div set:html={ticker + ticker + ticker + ticker} /></div>
  <ul class="facts">
    {es.hero.facts.map((f, i) => <li><b>{f.n}</b><span><T es={f.t} en={en.hero.facts[i].t} /></span></li>)}
  </ul>
</div>
