---
// Ilustración animada de una herramienta ITSM: ServiceNow y Jira cargan tickets que aparecen en el tablero, con estados que avanzan. Sin datos reales.
const T = 12;
const nav = [['Inicio', 'Home'], ['Tickets', 'Tickets'], ['Mis tareas', 'My tasks'], ['Seguimiento', 'Follow-up'], ['Cargas', 'Imports'], ['Personas y roles', 'People & roles']];
const rows = Array.from({ length: 6 }, (_, i) => ({ i, d: (1.2 + i * 0.55).toFixed(2), risk: i === 2, s: (i * 1.7).toFixed(1) }));
const st = [['Abierto', 'Open'], ['En curso', 'In progress'], ['Terminado', 'Done']];
---
<figure class="tk" style={`--T:${T}s`}>
  <div class="win" role="img" aria-label="Ilustración: ServiceNow y Jira cargan tickets automáticamente en un tablero con estados, tareas y seguimiento / Illustration: ServiceNow and Jira automatically load tickets into a board with statuses, tasks and follow-up">
    <div class="sd">
      {nav.map((n, i) => <span class={i === 1 ? 'on' : ''}><span data-l="es">{n[0]}</span><span data-l="en">{n[1]}</span></span>)}
    </div>
    <div class="mn">
      <div class="ld">
        <span class="src">ServiceNow</span><span class="src">Jira</span>
        <span class="pipe"><i></i><i></i><i></i></span>
        <span class="auto"><span data-l="es">carga automática</span><span data-l="en">automatic import</span></span>
      </div>
      <div class="kp"><span><b></b><u data-l="es">Abiertos</u><u data-l="en">Open</u></span><span class="rk"><b></b><u data-l="es">En riesgo</u><u data-l="en">At risk</u></span><span><b></b><u data-l="es">Atrasadas</u><u data-l="en">Overdue</u></span></div>
      <div class="ls">
        {rows.map((r) => (
          <div class={'rw' + (r.risk ? ' risk' : '')} style={`--d:${r.d}s;--s:${r.s}s`}>
            <span class="no"></span><span class="tx"><u></u><u></u></span>
            <span class="ch"><em data-l="es"><b class="s1">{st[0][0]}</b><b class="s2">{st[1][0]}</b><b class="s3">{st[2][0]}</b></em><em data-l="en"><b class="s1">{st[0][1]}</b><b class="s2">{st[1][1]}</b><b class="s3">{st[2][1]}</b></em></span>
            <span class="pp"></span>
          </div>
        ))}
      </div>
    </div>
  </div>
  <figcaption><span data-l="es">Ilustración: los tickets llegan desde ServiceNow y Jira, y el equipo los planifica y les da seguimiento.</span><span data-l="en">Illustration: tickets arrive from ServiceNow and Jira, and the team plans and tracks them.</span></figcaption>
</figure>
<style>
  .tk{margin:0;width:100%;flex:1;min-height:0;display:flex;flex-direction:column;gap:6px}
  .tk .win{flex:1;min-height:0;display:grid;grid-template-columns:104px 1fr;border:1px solid var(--line);border-radius:8px;background:var(--bg);overflow:hidden}
  .tk .sd{display:flex;flex-direction:column;gap:2px;padding:10px 8px;border-right:1px solid var(--line);background:var(--surface);font:400 11px var(--f-body);color:var(--dim)}
  .tk .sd>span{padding:5px 8px;border-radius:5px;white-space:nowrap}
  .tk .sd>span.on{background:var(--accent-soft);color:var(--accent);font-weight:600}
  .tk .mn{display:flex;flex-direction:column;gap:8px;padding:10px 12px;min-width:0;min-height:0}
  .tk .ld{display:flex;align-items:center;gap:8px;font:500 10px var(--f-mono)}
  .tk .src{padding:3px 9px;border:1px solid var(--accent);border-radius:11px;color:var(--ink);background:var(--accent-soft)}
  .tk .pipe{position:relative;flex:0 0 70px;height:2px;background:var(--line)}
  .tk .pipe i{position:absolute;top:-2px;width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent);animation:tkp 1.8s linear infinite}
  .tk .pipe i:nth-child(2){animation-delay:.6s}.tk .pipe i:nth-child(3){animation-delay:1.2s}
  @keyframes tkp{0%{left:0;opacity:0}15%{opacity:1}85%{opacity:1}100%{left:calc(100% - 6px);opacity:0}}
  .tk .auto{color:var(--accent);text-transform:uppercase;letter-spacing:.06em}
  .tk .kp{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .tk .kp span{border:1px solid var(--line);border-radius:6px;padding:6px 9px;background:var(--surface);display:grid;gap:3px}
  .tk .kp b{display:block;height:9px;width:34px;border-radius:3px;background:var(--dim);opacity:.6}
  .tk .kp u{text-decoration:none;font:400 9.5px var(--f-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--dim)}
  .tk .kp .rk{border-color:#ff8a65}.tk .kp .rk b{background:#ff8a65;opacity:.8}
  .tk .ls{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:space-evenly;gap:4px}
  .tk .rw{display:grid;grid-template-columns:44px 1fr 86px 22px;gap:10px;align-items:center;padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:var(--surface);animation:tkr var(--T) ease-out infinite;animation-delay:var(--d);animation-fill-mode:backwards}
  .tk .no{height:7px;border-radius:3px;background:var(--accent);opacity:.7}
  .tk .tx{display:grid;gap:4px}.tk .tx u{display:block;height:5px;border-radius:3px;background:var(--line)}.tk .tx u:last-child{width:55%;opacity:.6}
  .tk .pp{width:18px;height:18px;border-radius:50%;background:var(--line);border:1px solid var(--dim)}
  .tk .ch{position:relative;height:18px}
  .tk .ch em{position:absolute;inset:0;font-style:normal}
  .tk .ch b{position:absolute;left:0;top:0;font:500 9.5px var(--f-mono);letter-spacing:.04em;padding:2px 8px;border-radius:9px;border:1px solid var(--line);color:var(--dim);opacity:0;animation:var(--T) linear infinite;animation-delay:var(--s)}
  .tk .ch b.s1{animation-name:tks1}.tk .ch b.s2{animation-name:tks2;color:var(--accent);border-color:var(--accent)}.tk .ch b.s3{animation-name:tks3;color:var(--ink);background:var(--accent-soft);border-color:var(--accent)}
  .tk .rw.risk{border-color:#ff8a65;animation-name:tkr,tkk}
  .tk .rw.risk{animation-duration:var(--T),2s}
  .tk .rw.risk .ch b{color:#ff8a65;border-color:#ff8a65}
  @keyframes tkr{0%{opacity:0;transform:translateX(-14px)}8%{opacity:1;transform:none}92%{opacity:1}100%{opacity:0}}
  @keyframes tkk{50%{box-shadow:0 0 0 2px rgba(255,138,101,.25)}}
  @keyframes tks1{0%,28%{opacity:1}33%,100%{opacity:0}}
  @keyframes tks2{0%,30%{opacity:0}35%,62%{opacity:1}67%,100%{opacity:0}}
  @keyframes tks3{0%,64%{opacity:0}69%,100%{opacity:1}}
  .tk figcaption{font:400 11px var(--f-mono);color:var(--dim);letter-spacing:.03em}
  @media (max-width:640px){.tk .win{grid-template-columns:1fr}.tk .sd{display:none}.tk figcaption{display:none}}
  @media (prefers-reduced-motion:reduce){.tk .rw,.tk .pipe i,.tk .ch b{animation:none!important}.tk .ch b.s2{opacity:1}}
</style>
