---
// Réplica ilustrativa de un panel de promociones de un marketplace: el navegador de Claude recorre las publicaciones y las activa o desactiva. Productos y precios de ejemplo.
const T = 12, N = 7;
const items = [
  ['Zapatillas running hombre', 52990, 41990, 21], ['Auriculares bluetooth', 38990, 29990, 23], ['Mochila urbana 25 L', 27500, 21990, 20],
  ['Termo de acero 1 L', 24900, 18900, 24], ['Remera de algodón básica', 12990, 9990, 23], ['Campera inflable liviana', 68900, 54990, 20], ['Reloj deportivo digital', 31500, 23990, 24],
];
const fmt = (n: number) => '$' + n.toLocaleString('es-AR');
const rows = items.map((it, i) => ({ it, i, d: (((i + 0.5) * T) / (N + 0.5)).toFixed(2) }));
---
<figure class="mlp" style={`--T:${T}s`}>
  <div class="fit" role="img" aria-label="Réplica ilustrativa de un panel de promociones: el navegador de Claude recorre las publicaciones y las activa o desactiva / Illustrative replica of a promotions panel: Claude's browser goes through the listings switching them on or off">
    <div class="app">
      <div class="top"><i class="lg"></i><span class="sr"><u></u></span><nav><span data-l="es">Publicaciones</span><span data-l="en">Listings</span><span data-l="es">Ventas</span><span data-l="en">Sales</span><span class="on"><span data-l="es">Promociones</span><span data-l="en">Promotions</span></span><span data-l="es">Reputación</span><span data-l="en">Reputation</span></nav></div>
      <div class="pg">
        <div class="tt"><h4><span data-l="es">Promociones</span><span data-l="en">Promotions</span></h4><p><span data-l="es">Elegí qué publicaciones participan de la campaña</span><span data-l="en">Choose which listings join the campaign</span></p></div>
        <div class="tabs"><b><span data-l="es">Campañas activas</span><span data-l="en">Active campaigns</span></b><span><span data-l="es">Mis promociones</span><span data-l="en">My promotions</span></span><span><span data-l="es">Historial</span><span data-l="en">History</span></span></div>
        <div class="tb">
          <div class="th"><span></span><span data-l="es">Publicación</span><span data-l="en">Listing</span><span data-l="es">Precio</span><span data-l="en">Price</span><span data-l="es">Descuento</span><span data-l="en">Discount</span><span data-l="es">Estado</span><span data-l="en">Status</span><span></span></div>
          {rows.map(({ it, i, d }) => (
            <div class={'rw ' + (i % 2 ? 'b' : 'a')} style={`--d:${d}s`}>
              <span class="im"></span>
              <span class="nm"><b>{it[0]}</b><small>MLA{1100000000 + i * 137}</small></span>
              <span class="pr"><s>{fmt(it[1] as number)}</s><b>{fmt(it[2] as number)}</b></span>
              <span class="of">{it[3]}% OFF</span>
              <span class="st"><em class="on"><span data-l="es">Participa</span><span data-l="en">Joined</span></em><em class="off"><span data-l="es">No participa</span><span data-l="en">Not joined</span></em></span>
              <span class="sw"><span class="kn"></span></span>
            </div>
          ))}
        </div>
        <div class="scan"><svg class="cur" viewBox="0 0 16 20" width="22" height="28" aria-hidden="true"><path d="M1 1l12 9-5.2 1 3.2 7-2.4 1-3.2-7L1 17z" fill="#111" stroke="#fff" stroke-width="1.2"/></svg></div>
        <div class="ag"><i></i><span><b>Claude</b> · <span data-l="es">automatización de browser</span><span data-l="en">browser automation</span></span><span class="cnt"></span><span class="bar"><u></u></span></div>
      </div>
    </div>
  </div>
  <figcaption><span data-l="es">Réplica ilustrativa de un panel de promociones: publicaciones, precios y cifras de ejemplo.</span><span data-l="en">Illustrative replica of a promotions panel: sample listings, prices and figures.</span></figcaption>
</figure>
<style is:global>
  @property --pn{syntax:'<integer>';inherits:false;initial-value:0}
  .mlp{margin:0;width:100%;flex:1;min-height:0;display:flex;flex-direction:column;gap:6px}
  .mlp .fit{position:relative;flex:1;min-height:0;overflow:hidden;border:1px solid var(--line);border-radius:8px;background:#ebebeb}
  .mlp .app{position:absolute;left:0;top:0;width:1000px;height:520px;transform-origin:0 0;overflow:hidden;background:#ebebeb;color:#333;font:13px/1.3 "Proxima Nova","Segoe UI",system-ui,sans-serif;pointer-events:none}
  .mlp .top{height:48px;background:#ffe600;display:flex;align-items:center;gap:18px;padding:0 26px;box-shadow:0 1px 0 rgba(0,0,0,.1)}
  .mlp .lg{width:34px;height:24px;border-radius:12px;background:#2d3277;opacity:.85}
  .mlp .sr{flex:0 0 280px;height:28px;background:#fff;border-radius:2px;box-shadow:0 1px 2px rgba(0,0,0,.2);display:flex;align-items:center;padding:0 10px}.mlp .sr u{display:block;width:90px;height:6px;border-radius:3px;background:#ddd}
  .mlp nav{display:flex;gap:20px;margin-left:10px;font-size:12px;color:#333b}
  .mlp nav .on{color:#2968c8;font-weight:600}
  .mlp .pg{position:relative;padding:16px 26px;height:calc(100% - 48px)}
  .mlp .tt h4{margin:0;font-size:22px;font-weight:600}.mlp .tt p{margin:2px 0 10px;font-size:12px;color:#666}
  .mlp .tabs{display:flex;gap:22px;border-bottom:1px solid #d6d6d6;margin-bottom:10px;font-size:12.5px;color:#666}
  .mlp .tabs b{color:#3483fa;font-weight:600;padding-bottom:7px;border-bottom:2px solid #3483fa}
  .mlp .tb{background:#fff;border-radius:6px;box-shadow:0 1px 2px rgba(0,0,0,.12);overflow:hidden}
  .mlp .th,.mlp .rw{display:grid;grid-template-columns:44px 1.5fr 130px 92px 110px 52px;gap:12px;align-items:center;padding:0 16px}
  .mlp .th{height:30px;font-size:11px;color:#777;border-bottom:1px solid #eee;text-transform:uppercase;letter-spacing:.04em}
  .mlp .rw{min-height:46px;border-bottom:1px solid #f0f0f0;animation:mlf var(--T) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards}
  .mlp .im{width:34px;height:34px;border-radius:4px;background:linear-gradient(135deg,#e8e8e8,#d4d4d4)}
  .mlp .nm{display:flex;flex-direction:column}.mlp .nm b{font-weight:400;font-size:13px}.mlp .nm small{font-size:10.5px;color:#999}
  .mlp .pr{display:flex;flex-direction:column}.mlp .pr s{font-size:10.5px;color:#999}.mlp .pr b{font-size:14px;font-weight:600}
  .mlp .of{font-size:11.5px;color:#00a650;font-weight:600}
  .mlp .st{position:relative;height:20px}.mlp .st em{position:absolute;left:0;top:0;font-style:normal;font-size:10.5px;font-weight:600;padding:2px 9px;border-radius:10px;white-space:nowrap}
  .mlp .st .on{background:#e6f7ec;color:#00a650}.mlp .st .off{background:#eee;color:#777}
  .mlp .sw{position:relative;width:40px;height:22px;border-radius:11px;background:#bbb}
  .mlp .kn{position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.35)}
  .mlp .rw.a .sw{animation:mlsa calc(var(--T)*2) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards}
  .mlp .rw.a .kn{animation:mlka calc(var(--T)*2) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards}
  .mlp .rw.a .on{animation:mlon calc(var(--T)*2) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards}.mlp .rw.a .off{animation:mloff calc(var(--T)*2) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards}
  .mlp .rw.b .sw{background:#3483fa;animation:mlsb calc(var(--T)*2) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards}
  .mlp .rw.b .kn{left:20px;animation:mlkb calc(var(--T)*2) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards}
  .mlp .rw.b .on{animation:mloff calc(var(--T)*2) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards;opacity:1}.mlp .rw.b .off{opacity:0;animation:mlon calc(var(--T)*2) linear infinite;animation-delay:var(--d);animation-fill-mode:backwards}
  .mlp .rw.a .on{opacity:0}.mlp .rw.a .off{opacity:1}
  @keyframes mlf{0%{background:transparent}2%{background:#eef4ff}14%,100%{background:transparent}}
  @keyframes mlsa{0%{background:#bbb}2%,48%{background:#3483fa}50%,100%{background:#bbb}}
  @keyframes mlka{0%{left:2px}2%,48%{left:20px}50%,100%{left:2px}}
  @keyframes mlsb{0%{background:#3483fa}2%,48%{background:#bbb}50%,100%{background:#3483fa}}
  @keyframes mlkb{0%{left:20px}2%,48%{left:2px}50%,100%{left:20px}}
  @keyframes mlon{0%,2%{opacity:0}3%,48%{opacity:1}50%,100%{opacity:0}}
  @keyframes mloff{0%,2%{opacity:1}3%,48%{opacity:0}50%,100%{opacity:1}}
  .mlp .scan{position:absolute;left:26px;right:26px;top:130px;height:2px;background:#3483fa;box-shadow:0 0 12px 2px rgba(52,131,250,.55);animation:mlsc var(--T) linear infinite}
  @keyframes mlsc{0%{top:164px}100%{top:calc(164px + 338px)}}
  .mlp .cur{position:absolute;right:20px;top:-4px}
  .mlp .ag{position:absolute;right:40px;bottom:14px;display:flex;align-items:center;gap:10px;background:#111827;color:#e5e7eb;border-radius:8px;padding:8px 12px;font-size:11.5px;box-shadow:0 4px 14px rgba(0,0,0,.3)}
  .mlp .ag i{width:8px;height:8px;border-radius:50%;background:#3ed598;animation:mlb 1.2s ease-in-out infinite}
  @keyframes mlb{50%{opacity:.3}}
  .mlp .cnt{--pn:0;animation:mlc var(--T) linear infinite;counter-reset:pn var(--pn);font:600 11.5px var(--f-mono);color:#7ee787}
  .mlp .cnt::after{content:counter(pn)}
  @keyframes mlc{0%{--pn:0}100%{--pn:500}}
  .mlp .bar{width:80px;height:5px;border-radius:3px;background:#374151;overflow:hidden}.mlp .bar u{display:block;height:100%;background:#3ed598;animation:mlw var(--T) linear infinite}
  @keyframes mlw{0%{width:0}100%{width:100%}}
  .mlp figcaption{font:400 11px var(--f-mono);color:var(--dim);letter-spacing:.03em}
  @media (prefers-reduced-motion:reduce){.mlp .rw,.mlp .sw,.mlp .kn,.mlp .on,.mlp .off,.mlp .scan,.mlp .cnt,.mlp .bar u,.mlp .ag i{animation:none!important}.mlp .scan{display:none}.mlp .cnt::after{content:"300–500"}.mlp .bar u{width:70%}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('.mlp .fit').forEach((fit) => {
    const app = fit.querySelector<HTMLElement>('.app')!;
    const upd = () => { const s = fit.clientWidth / 1000; app.style.height = fit.clientHeight / s + 'px'; app.style.transform = `scale(${s})`; };
    new ResizeObserver(upd).observe(fit); upd();
  });
</script>
