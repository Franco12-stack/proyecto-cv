---
// Resumen legible del flujo real del agente: etapas (nombres reales de las secciones) y herramientas (nodos reales).
import flow from '../data/agente-flow.json';
const EN: Record<number, string> = { 1: 'Reception and debounce', 2: 'Preprocessing (images + messages)', 3: 'Label check', 4: 'AI agent + tools', 5: 'Post-processing and reply', 6: 'Marketplace and audio detection' };
const order = [1, 2, 3, 6, 4, 5];
const stages = order.map((n) => flow.groups.find((g) => g.n === n)!);
const tools = flow.nodes.filter((n) => n.kind === 'tool').map((n) => n.name);
const W = 108, H = 78, X0 = 8, STEP = 125, Y = 22;
const wrap = (s: string, max = 15) => {
  const out: string[] = []; let cur = '';
  for (const w of s.replace(/[()]/g, '').split(' ')) { if ((cur + ' ' + w).trim().length > max && cur) { out.push(cur); cur = w; } else cur = (cur + ' ' + w).trim(); }
  out.push(cur); return out.slice(0, 3);
};
const ax = X0 + 4 * STEP + W / 2; // centro del agente
const cols = [286, 446, 606], rows = [226, 268];
---
<figure class="pl" aria-label="Estructura del flujo del agente">
  <svg viewBox="0 0 760 330" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Etapas del flujo y herramientas del agente / Workflow stages and agent tools">
    <defs><marker id="pla" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 8 4 0 8z" fill="var(--accent)"/></marker></defs>
    {stages.slice(0, -1).map((_, i) => <path class="e" d={`M${X0 + i * STEP + W} ${Y + H / 2} H${X0 + (i + 1) * STEP - 2}`} marker-end="url(#pla)" />)}
    {stages.map((g, i) => (
      <g class={'st' + (g.n === 4 ? ' ag' : '')} transform={`translate(${X0 + i * STEP} ${Y})`}>
        <rect width={W} height={H} rx="8" />
        <text class="no" x="10" y="19">{String(i + 1).padStart(2, '0')}</text>
        {wrap(g.name).map((l, j) => <text data-l="es" class={'nm' + (l.length > 14 ? ' xs' : '')} x="10" y={40 + j * 14}>{l}</text>)}
        {wrap(EN[g.n]).map((l, j) => <text data-l="en" class={'nm' + (l.length > 14 ? ' xs' : '')} x="10" y={40 + j * 14}>{l}</text>)}
      </g>
    ))}
    <path class="e d" d={`M${ax} ${Y + H} V212`} />
    <path class="e d" d={`M${cols[0] + 72} 212 H${cols[2] + 72}`} />
    <path class="e d" d={`M${ax - 14} 128 H${ax}`} /><path class="e d" d={`M${ax} 128 H${ax + 14}`} />
    <g class="pill" transform={`translate(${ax - 14 - 112} 114)`}><rect width="112" height="28" rx="14" /><text data-l="es" x="56" y="18" text-anchor="middle">Modelo de chat</text><text data-l="en" x="56" y="18" text-anchor="middle">Chat model</text></g>
    <g class="pill" transform={`translate(${ax + 14} 114)`}><rect width="96" height="28" rx="14" /><text data-l="es" x="48" y="18" text-anchor="middle">Memoria</text><text data-l="en" x="48" y="18" text-anchor="middle">Memory</text></g>
    {tools.map((t, i) => {
      const x = cols[i % 3], y = rows[Math.floor(i / 3)];
      return <g><path class="e d" d={`M${x + 72} 212 V${y}`} /><g class="tl" transform={`translate(${x} ${y})`}><rect width="144" height="30" rx="6" /><text x="72" y="19" text-anchor="middle">{t}</text></g></g>;
    })}
    <text class="big" x="8" y="214">{flow.nodes.length}</text>
    <text class="sm" x="62" y="198"><tspan data-l="es">nodos</tspan><tspan data-l="en">nodes</tspan></text>
    <text class="sm" x="62" y="214">{flow.edges.length}<tspan data-l="es"> conexiones</tspan><tspan data-l="en"> connections</tspan></text>
    <text class="sm dim" x="8" y="252"><tspan data-l="es">Estructura de un flujo real</tspan><tspan data-l="en">Structure of a real workflow</tspan></text>
    <text class="sm dim" x="8" y="268"><tspan data-l="es">exportado de n8n.</tspan><tspan data-l="en">exported from n8n.</tspan></text>
  </svg>
</figure>
<style>
  .pl{margin:0;width:100%;flex:1;min-height:0;display:flex}
  .pl svg{width:100%;height:100%}
  .pl .e{fill:none;stroke:var(--accent);stroke-width:2;stroke-dasharray:6 5;animation:pld 1.4s linear infinite}
  .pl .e.d{stroke:var(--dim);stroke-width:1.5;stroke-dasharray:4 4;animation:none}
  @keyframes pld{to{stroke-dashoffset:-22}}
  .pl .st rect{fill:var(--surface);stroke:var(--line);stroke-width:1.5}
  .pl .st.ag rect{stroke:var(--accent);fill:var(--accent-soft);filter:drop-shadow(0 0 10px var(--accent))}
  .pl .no{font:500 11px var(--f-mono);fill:var(--accent)}
  .pl .nm{font:600 12.5px var(--f-body);fill:var(--ink)}
  .pl .nm.xs{font-size:10.8px}
  .pl .pill rect,.pl .tl rect{fill:var(--surface);stroke:var(--accent);stroke-width:1.3;stroke-dasharray:4 3}
  .pl .tl rect{stroke-dasharray:none;fill:var(--accent-soft)}
  .pl .pill text{font:500 11px var(--f-mono);fill:var(--ink)}
  .pl .tl text{font:500 11.5px var(--f-mono);fill:var(--ink)}
  .pl .big{font:700 46px var(--f-display);fill:var(--accent);letter-spacing:-.03em}
  .pl .sm{font:400 11.5px var(--f-mono);fill:var(--ink);letter-spacing:.05em;text-transform:uppercase}
  .pl .sm.dim{fill:var(--dim);text-transform:none;letter-spacing:.02em}
  @media (prefers-reduced-motion:reduce){.pl .e{animation:none}}
</style>
