---
import es from '../data/site.es.json';
import en from '../data/site.en.json';
import xes from '../data/experience.es.json';
import xen from '../data/experience.en.json';
import T from './T.astro';
---
<section class="sec" id="experiencia">
  <h2><T es={es.sections.experience} en={en.sections.experience} /></h2>
  <div class="body">
    {xes.map((x, i) => (
      <div class="job">
        <h3><T es={x.role} en={xen[i].role} /></h3>
        <span class={'when' + (x.current ? ' on' : '')}><T es={x.when} en={xen[i].when} /></span>
        <ul class="jb">{(x as any).items.map((t: string, j: number) => <li><T es={t} en={(xen[i] as any).items[j]} /></li>)}</ul>
      </div>
    ))}
  </div>
</section>
