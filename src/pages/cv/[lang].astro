---
// Versión imprimible del CV. `npm run assets` la convierte a PDF en /public.
import es from '../../data/site.es.json';
import en from '../../data/site.en.json';
import xes from '../../data/experience.es.json';
import xen from '../../data/experience.en.json';
import pes from '../../data/projects.es.json';
import pen from '../../data/projects.en.json';
import ees from '../../data/education.es.json';
import een from '../../data/education.en.json';
import stack from '../../data/stack.json';

export function getStaticPaths() { return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }]; }
const { lang } = Astro.params as { lang: 'es' | 'en' };
const L = lang === 'es';
const S = L ? es : en, X = L ? xes : xen, P = L ? pes : pen, E = L ? ees : een;
const T = {
  profile: L ? 'Perfil' : 'Profile', exp: L ? 'Experiencia' : 'Experience', proj: L ? 'Proyectos' : 'Projects',
  stack: 'Stack', edu: L ? 'Formación y certificaciones' : 'Education & certifications', lang: L ? 'Idiomas' : 'Languages',
  role: L ? 'Automatización e IA' : 'Automation & AI',
};
const strip = (s: string) => s.replace(/<[^>]+>/g, '');
const tech = stack.items.map((s) => (L ? s.name : (s as any).nameEn ?? s.name));
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8"><meta name="robots" content="noindex">
  <title>Franco Fernandez · CV</title>
  <style>
    @page{size:A4;margin:16mm 15mm}
    *{box-sizing:border-box}
    body{font:10.5pt/1.45 'IBM Plex Sans','Segoe UI',Arial,sans-serif;color:#12202A;margin:0;max-width:180mm}
    h1{font:700 24pt/1.1 'Bricolage Grotesque','Segoe UI',Arial,sans-serif;margin:0 0 2pt}
    .role{color:#0B7566;font:500 11pt 'JetBrains Mono',monospace;margin:0 0 4pt}
    .contact{font-size:9.5pt;color:#5A6D78;margin:0 0 10pt}
    h2{font:500 9.5pt 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:#0B7566;border-bottom:1px solid #D0DADF;padding-bottom:2pt;margin:13pt 0 6pt}
    p{margin:0 0 4pt}
    .job,.pj{margin:0 0 7pt;break-inside:avoid}
    .row{display:flex;justify-content:space-between;gap:12pt}
    .row b{font-weight:600}.when{color:#5A6D78;white-space:nowrap;font-size:9.5pt}
    .sub{color:#5A6D78}
    ul{margin:0;padding-left:14pt}
  </style>
</head>
<body>
  <h1>Franco Fernandez</h1>
  <p class="role">{T.role}</p>
  <p class="contact">Buenos Aires, Argentina · {stack.contact.email} · {stack.contact.linkedin.replace('https://www.', '').replace('%C3%A1', 'á')}</p>

  <h2>{T.profile}</h2>
  <p>{strip(S.hero.h1)} {S.hero.lead}</p>
  <p>{S.about.p.join(' ')}</p>

  <h2>{T.exp}</h2>
  {X.map((x) => <div class="job"><div class="row"><b>{x.role}</b><span class="when">{x.when}</span></div><p>{x.text}</p></div>)}

  <h2>{T.proj}</h2>
  {P.map((p) => <div class="pj"><b>{p.title}</b> <span class="sub">({p.tags.join(' · ')})</span><p>{p.summary}</p></div>)}

  <h2>{T.stack}</h2>
  <p>{tech.join(' · ')}</p>

  <h2>{T.edu}</h2>
  <ul>{E.map((e) => <li><b>{e.title}</b> <span class="sub">— {e.sub}</span></li>)}</ul>

  <h2>{T.lang}</h2>
  <p>{S.contact.langs}</p>
</body>
</html>
