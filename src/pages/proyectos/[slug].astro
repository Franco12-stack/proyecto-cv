---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import es from '../../data/site.es.json';
import en from '../../data/site.en.json';
import pes from '../../data/projects.es.json';
import pen from '../../data/projects.en.json';
import { url } from '../../lib/url';
import N8nFlow from '../../components/N8nFlow.astro';

export function getStaticPaths() {
  return pes.map((p, i) => ({ params: { slug: p.slug }, props: { i } }));
}
const { i } = Astro.props;
const a: any = pes[i], b: any = pen[i];
const sec = ['context', 'solution'] as const;
---
<Base
  title={{ es: `${a.title} · Franco Fernandez`, en: `${b.title} · Franco Fernandez` }}
  description={{ es: a.summary, en: b.summary }}
  path={`/proyectos/${a.slug}/`}>
  <article class={'case' + (a.gallery ? ' wide' : '')}>
    <a class="back" href={url('/#proyectos')}><T es={es.ui.back} en={en.ui.back} /></a>
    <h1><T es={a.title} en={b.title} /></h1>
    <p class="lead"><T es={a.summary} en={b.summary} /></p>
    {a.diagram && <div style="border:1px solid var(--line);background:var(--surface);padding:16px;margin:0 0 20px"><N8nFlow /></div>}
    {a.image && <img src={url('/' + a.image)} alt={a.imageAlt} width="1280" height="800" style="width:100%;height:auto;border:1px solid var(--line);margin:0 0 20px" />}
    {a.links?.github && <p class="btns"><a class="btn" href={a.links.github} target="_blank" rel="noopener"><T es="Ver código en GitHub ↗" en="View code on GitHub ↗" /></a></p>}
    {sec.map((k) => (
      <section>
        <h2><T es={es.ui.caseSections[k]} en={en.ui.caseSections[k]} /></h2>
        <p><T es={a[k]} en={b[k]} /></p>
      </section>
    ))}
    <section>
      <h2><T es={es.ui.caseSections.result} en={en.ui.caseSections.result} /></h2>
      <ul class="res">{a.result.map((r, j) => <li><T es={r} en={b.result[j]} /></li>)}</ul>
    </section>
    {a.highlights && <section>
      <h2><T es={a.highlightsTitle} en={b.highlightsTitle} /></h2>
      <ul class="res">{a.highlights.map((r: string, j: number) => <li><T es={r} en={b.highlights[j]} /></li>)}</ul>
    </section>}
    {a.gallery && <section>
      <h2><T es="Capturas" en="Screenshots" /></h2>
      <ul class="shots">{a.gallery.map((g: any, j: number) => <li><figure><img src={url('/' + g.img)} alt={g.cap} loading="lazy" decoding="async" width="1280" height="800" /><figcaption><T es={g.cap} en={b.gallery[j].cap} /></figcaption></figure></li>)}</ul>
    </section>}
    {a.note && <p class="note"><T es={a.note} en={b.note} /></p>}
    <section>
      <h2><T es={es.ui.caseSections.stack} en={en.ui.caseSections.stack} /></h2>
      <ul class="tags">{a.tags.map((t, j) => <li><T es={t} en={b.tags[j]} /></li>)}</ul>
    </section>
    <section>
      <h2><T es={es.ui.otherCases.replace('// ', '')} en={en.ui.otherCases.replace('// ', '')} /></h2>
      <ul class="others">
        {pes.map((p, j) => j !== i && <li><a href={url(`/proyectos/${p.slug}/`)}><T es={p.title} en={pen[j].title} /></a></li>)}
      </ul>
    </section>
  </article>
</Base>
