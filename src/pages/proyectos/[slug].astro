---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import es from '../../data/site.es.json';
import en from '../../data/site.en.json';
import pes from '../../data/projects.es.json';
import pen from '../../data/projects.en.json';
import { url } from '../../lib/url';
import N8nCanvas from '../../components/N8nCanvas.astro';
import BrowserScan from '../../components/BrowserScan.astro';
import ObsidianGraph from '../../components/ObsidianGraph.astro';
import PriceWatch from '../../components/PriceWatch.astro';
import TicketApp from '../../components/TicketApp.astro';

export function getStaticPaths() {
  return pes.map((p, i) => ({ params: { slug: p.slug }, props: { i } }));
}
const { i } = Astro.props;
const a: any = pes[i], b: any = pen[i];
const sec = ['context', 'solution'] as const;
---
<Base
  title={{ es: `${a.title} · Franco Fernandez`, en: `${b.title} · Franco Fernandez` }}
  description={{ es: a.summary, en: b.summary }}
  path={`/proyectos/${a.slug}/`}>
  <article class={'case' + ((a.gallery || a.diagram === 'n8n') ? ' wide' : '')}>
    <a class="back" href={url('/#proyectos')}><T es={es.ui.back} en={en.ui.back} /></a>
    <h1><T es={a.title} en={b.title} /></h1>
    <p class="lead"><T es={a.summary} en={b.summary} /></p>
    {a.diagram === 'n8n' && <section>
      <h2><T es="El flujo en n8n" en="The n8n workflow" /></h2>
      <N8nCanvas mode="full" />
      <p class="note"><T es="Estructura real de un flujo del agente (ventas y posventa), exportado de n8n: nodos, tipos y conexiones. Se publican solo nombres y conexiones; los parámetros, prompts, credenciales y datos de clientes no. Arrastrá para moverte y usá Ctrl/⌘ + rueda o los botones para el zoom." en="Real structure of one of the agent’s workflows (sales and after-sales), exported from n8n: nodes, types and connections. Only names and connections are published; parameters, prompts, credentials and customer data are not. Drag to move and use Ctrl/⌘ + wheel or the buttons to zoom." /></p>
    </section>}
    {(a.diagram === 'promos' || a.diagram === 'brain' || a.diagram === 'prices' || a.diagram === 'tickets') && <div style="height:360px;display:flex;flex-direction:column;border:1px solid var(--line);background:var(--surface);padding:14px;margin:0 0 20px">{a.diagram === 'promos' ? <BrowserScan /> : a.diagram === 'prices' ? <PriceWatch /> : a.diagram === 'tickets' ? <TicketApp /> : <ObsidianGraph />}</div>}
    {a.image && <img src={url('/' + a.image)} alt={a.imageAlt} width="1280" height="800" style="width:100%;height:auto;border:1px solid var(--line);margin:0 0 20px" />}
    {a.links?.github && <p class="btns"><a class="btn" href={a.links.github} target="_blank" rel="noopener"><T es="Ver código en GitHub ↗" en="View code on GitHub ↗" /></a></p>}
    {sec.map((k) => (
      <section>
        <h2><T es={es.ui.caseSections[k]} en={en.ui.caseSections[k]} /></h2>
        <p><T es={a[k]} en={b[k]} /></p>
      </section>
    ))}
    <section>
      <h2><T es={es.ui.caseSections.result} en={en.ui.caseSections.result} /></h2>
      <ul class="res">{a.result.map((r, j) => <li><T es={r} en={b.result[j]} /></li>)}</ul>
    </section>
    {a.extra && a.extra.map((x: any, k: number) => <section>
      <h2><T es={x.title} en={b.extra[k].title} /></h2>
      <ul class="res">{x.items.map((r: string, j: number) => <li><T es={r} en={b.extra[k].items[j]} /></li>)}</ul>
    </section>)}
    {a.highlights && <section>
      <h2><T es={a.highlightsTitle} en={b.highlightsTitle} /></h2>
      <ul class="res">{a.highlights.map((r: string, j: number) => <li><T es={r} en={b.highlights[j]} /></li>)}</ul>
    </section>}
    {a.gallery && <section>
      <h2><T es="Capturas" en="Screenshots" /></h2>
      <ul class="shots">{a.gallery.map((g: any, j: number) => <li><figure><img src={url('/' + g.img)} alt={g.cap} loading="lazy" decoding="async" width="1280" height="800" /><figcaption><T es={g.cap} en={b.gallery[j].cap} /></figcaption></figure></li>)}</ul>
    </section>}
    {a.note && <p class="note"><T es={a.note} en={b.note} /></p>}
    <section>
      <h2><T es={es.ui.caseSections.stack} en={en.ui.caseSections.stack} /></h2>
      <ul class="tags">{a.tags.map((t, j) => <li><T es={t} en={b.tags[j]} /></li>)}</ul>
    </section>
    <section>
      <h2><T es={es.ui.otherCases.replace('// ', '')} en={en.ui.otherCases.replace('// ', '')} /></h2>
      <ul class="others">
        {pes.map((p, j) => j !== i && <li><a href={url(`/proyectos/${p.slug}/`)}><T es={p.title} en={pen[j].title} /></a></li>)}
      </ul>
    </section>
  </article>
</Base>
