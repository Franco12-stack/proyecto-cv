---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import es from '../data/site.es.json';
import en from '../data/site.en.json';
import stack from '../data/stack.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { abs, url } from '../lib/url';

interface Props { title?: { es: string; en: string }; description?: { es: string; en: string }; path?: string; noindex?: boolean; home?: boolean; bare?: boolean }
const { title = { es: es.title, en: en.title }, description = { es: es.description, en: en.description }, path = '/', noindex = false, home = false, bare = false } = Astro.props;

const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Franco Fernandez',
  jobTitle: 'Automation & AI Engineer', url: abs('/'), image: abs('/foto.jpg'), email: stack.contact.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'UADE' },
  knowsLanguage: ['es', 'en', 'pt'],
  knowsAbout: ['Automatización de procesos', 'Agentes de IA', 'n8n', 'Power Automate', 'Python', 'LLMs'],
  sameAs: [stack.contact.linkedin, stack.contact.github],
};
const og = abs('/og-image-v2.png');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title data-title-es={title.es} data-title-en={title.en}>{title.es}</title>
  <meta name="description" content={description.es}>
  <link rel="canonical" href={abs(path)}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#0C1519">
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Franco Fernandez">
  <meta property="og:title" content={title.es}>
  <meta property="og:description" content={description.es}>
  <meta property="og:url" content={abs(path)}>
  <meta property="og:image" content={og}>
  <meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta property="og:locale" content="es_AR"><meta property="og:locale:alternate" content="en_US">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title.es}>
  <meta name="twitter:description" content={description.es}>
  <meta name="twitter:image" content={og}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
  <script is:inline>
    try{var d=document.documentElement,l=localStorage.getItem('ff-lang'),t=localStorage.getItem('ff-theme');
    if(l==='en'||l==='es')d.lang=l;if(t==='dark'||t==='light')d.setAttribute('data-theme',t)}catch(e){}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
</head>
<body>
  <a class="skip" href="#main"><span data-l="es">{es.ui.skip}</span><span data-l="en">{en.ui.skip}</span></a>
  <div id="progress"></div>
  <div id="ring" aria-hidden="true"></div>
  <div class="wrap">
    <Header home={home} />
    <main id="main"><slot /></main>
    <Footer />
  </div>
  <script>
    import { initLang } from '../scripts/i18n.js';
    import { initTheme } from '../scripts/theme.js';
    import { initStack } from '../scripts/stack.js';
    import { initClock, initProgress, initActiveNav, initCopy } from '../scripts/nav.js';
    import { initCursor } from '../scripts/cursor.js';
    import { initPortrait } from '../scripts/portrait.js';
    import { initProjects } from '../scripts/projects.js';
    initTheme(); initStack(); initClock(); initProgress(); initActiveNav(); initCopy(); initCursor(); initPortrait(); initProjects();
    initLang();
  </script>
</body>
</html>
